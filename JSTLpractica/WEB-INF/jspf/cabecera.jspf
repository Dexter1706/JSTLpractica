<%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %>
<%--
  Cabecera común. Antes de incluirla, cada página puede definir:
    titulo   -> título de la página
    etiqueta -> etiqueta JSTL que se practica (ej: c:out)
    guia     -> "Guía 1" o "Guía 2"
    esInicio -> true solo en el index principal (oculta el botón "Volver al inicio")
--%>
<c:set var="ctx" value="${pageContext.request.contextPath}"/>
<!DOCTYPE html>
<html lang="es" data-bs-theme="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><c:out value="${empty titulo ? 'JSTL' : titulo}"/></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Barlow:wght@400;500;600;700&family=Barlow+Condensed:wght@600;700;800&display=swap" rel="stylesheet">
  <link href="${ctx}/css/estilos.css" rel="stylesheet">
</head>
<body>
<nav class="navbar navbar-expand barra sticky-top">
  <div class="container">
    <a class="navbar-brand marca" href="${ctx}/index.jsp">
      <span class="marca-logo">JSTL</span>
      <span class="d-none d-sm-inline">Pr&aacute;ctica JSTL</span>
    </a>
    <c:if test="${not esInicio}">
      <a class="btn btn-inicio rounded-pill" href="${ctx}/index.jsp">
        <i class="bi bi-house-door-fill"></i> Volver al inicio
      </a>
    </c:if>
  </div>
</nav>

<main class="container py-4 flex-grow-1">
<c:if test="${not esInicio}">
  <div class="encabezado-pagina">
    <div class="d-flex flex-wrap gap-2 mb-2">
      <c:if test="${not empty guia}"><span class="chip chip-guia"><c:out value="${guia}"/></span></c:if>
      <c:if test="${not empty etiqueta}"><span class="chip chip-tag"><i class="bi bi-code-slash"></i> <c:out value="${etiqueta}"/></span></c:if>
    </div>
    <h1 class="titulo-pagina"><c:out value="${titulo}"/></h1>
  </div>
  <div class="tarjeta-contenido">
</c:if>
